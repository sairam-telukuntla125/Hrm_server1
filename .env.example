PORT=3005
ENVIRONMENT=PRODUCTION
DB_URL_PROD=mongodb+srv://<username>:<password>@<cluster>/hrms?retryWrites=true&w=majority
JWT_ACCESS_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value
# Comma-separated frontend origins. Do not include a trailing slash.
CLIENT_ORIGINS=https://your-frontend-domain.example,http://localhost:3000
# Gmail SMTP configuration for password reset emails. Create a Gmail App Password
# after enabling 2-Step Verification on the sender account.
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-gmail-app-password
MAIL_FROM_NAME=NEUZEN AI HRMS
CLIENT_APP_URL=https://your-frontend-domain.example
